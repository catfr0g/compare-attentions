# Скопируйте в .env и заполните реальные значения; .env в git не попадает.
# Команда `train` сама читает .env из текущего каталога (переменные окружения важнее файла).
#
# --- ClearML ---
# Креды: https://app.clear.ml/settings/workspace-configuration
# (та же замена разовому `clearml-init`; можно указывать только пару ключей)
CLEARML_API_ACCESS_KEY=
CLEARML_API_SECRET_KEY=

# Хосты облачного ClearML; в self-hosted замените на адрес своего сервера.
CLEARML_API_HOST=https://api.clear.ml
CLEARML_WEB_HOST=https://app.clear.ml
CLEARML_FILES_HOST=https://files.clear.ml

# --- Hugging Face ---
# Токен для приватного репозитория чекпоинтов: https://huggingface.co/settings/tokens
HF_TOKEN=

# Приватный репозиторий для выгрузки результатов запуска (runs/<имя каталога>).
# Перекрывается флагом --hf-repo; без значения выгрузка не выполняется.
HF_REPO=

# --- Kaggle (для scripts/train_kaggle.py) ---
# Логин и ключ: https://www.kaggle.com/settings/api (токен или legacy kaggle.json)
KAGGLE_USERNAME=
KAGGLE_KEY=
